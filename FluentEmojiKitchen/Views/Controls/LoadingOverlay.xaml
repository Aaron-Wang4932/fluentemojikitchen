<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="FluentEmojiKitchen.Views.Controls.LoadingOverlay"
    xmlns:models="using:FluentEmojiKitchen.Presentation">
    <Grid Background="#2A2A2A">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock
                Text="Loading emojis..."
                Opacity="0.6"
                HorizontalAlignment="Center"
                x:Name="LoadingMessage"
                TextWrapping="Wrap"
                TextAlignment="Center"
                MaxWidth="280" />
            <ProgressBar x:Name="LoadingProgressBar" Width="200" Minimum="0" Maximum="100" Value="0" />
        </StackPanel>
    </Grid>
</UserControl>
