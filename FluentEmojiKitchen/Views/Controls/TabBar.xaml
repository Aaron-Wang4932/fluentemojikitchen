<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="FluentEmojiKitchen.Views.Controls.TabBar"
    xmlns:models="using:FluentEmojiKitchen.Presentation">
    <Grid Padding="12,10,12,6" x:Name="TabStripGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="6">
            <ToggleButton
                x:Name="EmojiTabButton"
                Content="Emoji"
                IsChecked="True"
                Click="OnEmojiTabClick"
                CornerRadius="14"
                Padding="8,6" />
            <ToggleButton
                x:Name="KitchenTabButton"
                Content="Kitchen"
                Click="OnKitchenTabClick"
                CornerRadius="14"
                Padding="8,6" />
        </StackPanel>
        <Button x:Name="SettingsButton" Grid.Column="1" Click="OnSettingsClick"
            Background="Transparent" BorderThickness="0" Padding="8,4" VerticalAlignment="Center"
            ToolTipService.ToolTip="Settings" AutomationProperties.Name="Settings">
            <FontIcon Glyph="&#xE713;" FontSize="16" />
        </Button>
        <Button
            x:Name="CloseButton"
            Grid.Column="2"
            Content="✕"
            Click="OnCloseButtonClick"
            Background="Transparent"
            BorderThickness="0"
            Padding="8,4"
            VerticalAlignment="Center" />
    </Grid>
</UserControl>
