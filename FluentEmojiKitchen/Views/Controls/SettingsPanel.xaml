<UserControl
    x:Class="FluentEmojiKitchen.Views.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Padding="16">
            <TextBlock Text="Settings" FontWeight="SemiBold" />
            <Grid>
                <TextBlock Text="Emoji columns" />
                <TextBlock Text="{Binding Value, ElementName=ColumnsSlider}" HorizontalAlignment="Right" />
            </Grid>
            <Slider x:Name="ColumnsSlider" Minimum="6" Maximum="20" Value="6"
                StepFrequency="1" TickFrequency="1" SnapsTo="StepValues"
                AutomationProperties.Name="Emoji columns" />
            <Button x:Name="ApplyButton" Content="Apply columns" Click="OnApply" />
            <Button x:Name="RebuildButton" Content="Rebuild all caches" Click="OnRebuild" />
            <TextBlock Text="Forcibly redownloads all app assets."
                TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
            <TextBlock x:Name="Status" TextWrapping="Wrap" FontSize="12" />
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
