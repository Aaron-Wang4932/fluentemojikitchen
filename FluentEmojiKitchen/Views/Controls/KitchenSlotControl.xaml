<UserControl
    x:Class="FluentEmojiKitchen.Views.Controls.KitchenSlotControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:fonts="using:FluentEmojiKitchen.Services.Windows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="72" Height="72" Background="Transparent" Tapped="OnTapped">
        <Rectangle x:Name="SlotBorder" RadiusX="14" RadiusY="14"
                   Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.5" StrokeDashArray="4,3" />
        <TextBlock x:Name="PlusText" Text="+" FontSize="30" FontWeight="Bold" Opacity="0.6"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <TextBlock x:Name="EmojiText" FontFamily="{StaticResource NotoColorEmoji}" fonts:EmojiFontResources.UseEmojiFont="True" FontSize="34"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <Button x:Name="ClearButton" Content="✕" Tapped="OnClearTapped" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-8,0"
                Width="22" Height="22" Padding="0" FontSize="10" CornerRadius="11"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
    </Grid>
</UserControl>
