<UserControl
    x:Class="FluentEmojiKitchen.Views.Controls.EmojiTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:fonts="using:FluentEmojiKitchen.Services.Windows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Width="48" Height="48" Background="Transparent"
          PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" Tapped="OnTapped"
          ToolTipService.ToolTip="{x:Bind Item.EmojiName, Mode=OneWay}">
        <Border x:Name="HoverLayer" CornerRadius="8" Background="#55000000" Opacity="0" />
        <Border CornerRadius="8" BorderThickness="2" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Opacity="{x:Bind Item.SelectedOpacity, Mode=OneWay}" />
        <TextBlock Text="{x:Bind Item.Character, Mode=OneWay}" FontFamily="{StaticResource NotoColorEmoji}" fonts:EmojiFontResources.UseEmojiFont="True"
                   FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
</UserControl>
