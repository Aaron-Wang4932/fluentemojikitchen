<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:FluentEmojiKitchen.Views.Controls"
    xmlns:layouts="using:FluentEmojiKitchen.Views.Layouts"
    xmlns:fonts="using:FluentEmojiKitchen.Services.Windows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="FluentEmojiKitchen.Views.EmojiPanelView"
    xmlns:models="using:FluentEmojiKitchen.Presentation"
    xmlns:converters="using:FluentEmojiKitchen.Views.Converters">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox
            x:Name="EmojiPanelSearchBox"
            Grid.Row="0"
            Margin="12,0,12,8"
            PlaceholderText="Search emojis"
            CornerRadius="6"
            TextChanged="OnSearchTextChanged"
            SelectionHighlightColor="DeepSkyBlue"
            Visibility="Collapsed" />
        <InfoBar x:Name="ErrorBar" Grid.Row="1" IsOpen="False" Severity="Warning" />
        <Grid Grid.Row="2">
            <ScrollView
                x:Name="EmojiTabContent"
                Padding="8,0,8,12"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Hidden"
                ViewChanged="OnEmojiTabContentScrolled">
                <StackPanel>
                    <ItemsRepeater x:Name="EmojiRepeater" VerticalCacheLength="6">
                        <ItemsRepeater.Layout>
                            <layouts:EmojiSectionStackLayout />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:EmojiSection">
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                    <TextBlock
                                        Text="{x:Bind GroupName}"
                                        Visibility="{x:Bind ShowGroupHeading, Converter={StaticResource BoolVisibility}}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Margin="0,8,0,2" />
                                    <TextBlock
                                        Text="{x:Bind SubgroupName, Mode=OneWay}"
                                        FontSize="12"
                                        Opacity="0.6"
                                        Margin="0,0,0,4" />
                                    <ItemsRepeater ItemsSource="{x:Bind Emojis}" VerticalCacheLength="2">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MinItemWidth="48"
                                                MinItemHeight="48"
                                                ItemsStretch="Fill"
                                                MinRowSpacing="2"
                                                MinColumnSpacing="2" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:EmojiItem">
                                                <Grid Width="48" Height="48" Background="Transparent"
                                                      Tag="{x:Bind}"
                                                      PointerEntered="OnEmojiPointerEntered"
                                                      PointerExited="OnEmojiPointerExited"
                                                      Tapped="OnEmojiItemTapped"
                                                      DoubleTapped="OnEmojiDoubleTapped"
                                                      ToolTipService.ToolTip="{x:Bind EmojiName}">
                                                    <Border x:Name="HoverLayer" CornerRadius="8"
                                                            Background="#55000000" Opacity="0" />
                                                    <Border CornerRadius="8" BorderThickness="2"
                                                            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                            Opacity="{x:Bind SelectedOpacity, Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind Character}"
                                                               FontFamily="{StaticResource NotoColorEmoji}" fonts:EmojiFontResources.UseEmojiFont="True"
                                                               FontSize="28" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock
                        Text="no more emojis down here o(〃＾▽＾〃)o"
                        HorizontalAlignment="Center"
                        Opacity="0.5"
                        Margin="0,16,0,24" />
                </StackPanel>
            </ScrollView>
            <ScrollView
                x:Name="SearchResultsContent"
                Padding="8,0,8,12"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Hidden"
                Visibility="Collapsed">
                <ItemsRepeater x:Name="SearchResultsRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            MinItemWidth="48"
                            MinItemHeight="48"
                            ItemsStretch="Fill"
                            MinRowSpacing="2"
                            MinColumnSpacing="2" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:EmojiItem">
                            <Grid Width="48" Height="48" Background="Transparent"
                                  Tag="{x:Bind}"
                                  PointerEntered="OnEmojiPointerEntered"
                                  PointerExited="OnEmojiPointerExited"
                                  Tapped="OnEmojiItemTapped"
                                  DoubleTapped="OnEmojiDoubleTapped"
                                  ToolTipService.ToolTip="{x:Bind EmojiName}">
                                <Border x:Name="HoverLayer" CornerRadius="8"
                                        Background="#55000000" Opacity="0" />
                                <Border CornerRadius="8" BorderThickness="2"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        Opacity="{x:Bind SelectedOpacity, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Character}"
                                           FontFamily="{StaticResource NotoColorEmoji}" fonts:EmojiFontResources.UseEmojiFont="True"
                                           FontSize="28" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollView>
            <Button
                x:Name="ScrollToTopButton"
                Visibility="Collapsed"
                Click="OnScrollToTopClick"
                ClickMode="Press"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                CornerRadius="20"
                Width="40"
                Height="40"
                Padding="0"
                Opacity="0"
                IsHitTestVisible="False"
                Background="#CC2A2A2A">
                <FontIcon Glyph="" FontSize="16" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
