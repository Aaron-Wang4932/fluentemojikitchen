<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:FluentEmojiKitchen.Views.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="FluentEmojiKitchen.Views.KitchenPanelView"
    xmlns:models="using:FluentEmojiKitchen.Presentation">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,16" Spacing="20">
            <controls:KitchenSlotControl
                x:Name="LeftSlot"
                Tag="Left"
                SlotTapped="OnSlotTapped"
                ClearRequested="OnSlotCleared" />
            <controls:KitchenSlotControl
                x:Name="RightSlot"
                Tag="Right"
                SlotTapped="OnSlotTapped"
                ClearRequested="OnSlotCleared" />
        </StackPanel>
        <Grid Grid.Row="1">
            <TextBlock
                x:Name="KitchenHintText"
                Text="Pick two emoji to kitchenify them!"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                Opacity="0.5" />
            <Grid x:Name="KitchenPickerContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="KitchenSearchBox"
                    Grid.Row="0"
                    Margin="8,0,8,8"
                    PlaceholderText="Search emojis"
                    CornerRadius="6"
                    TextChanged="OnKitchenSearchTextChanged" />
                <ScrollView
                    x:Name="KitchenPickerGroupedContent"
                    Grid.Row="1"
                    Padding="8,0,8,12"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Hidden">
                    <ItemsRepeater x:Name="KitchenPickerRepeater" VerticalCacheLength="6">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:EmojiSection">
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                    <TextBlock
                                        Text="{x:Bind GroupName}"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Margin="0,8,0,2" />
                                    <ItemsRepeater ItemsSource="{x:Bind Emojis}" VerticalCacheLength="6">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout
                                                MinItemWidth="48"
                                                MinItemHeight="48"
                                                ItemsStretch="Fill"
                                                MinRowSpacing="2"
                                                MinColumnSpacing="2" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:EmojiItem">
                                                <controls:EmojiTile Item="{x:Bind}" Invoked="OnEmojiChosen"
                                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                    Opacity="{x:Bind TileOpacity, Mode=OneWay}" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollView>
                <ScrollView
                    x:Name="KitchenPickerSearchResultsContent"
                    Grid.Row="1"
                    Padding="8,0,8,12"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    Visibility="Collapsed">
                    <ItemsRepeater x:Name="KitchenPickerSearchResultsRepeater">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout
                                MinItemWidth="48"
                                MinItemHeight="48"
                                ItemsStretch="Fill"
                                MinRowSpacing="2"
                                MinColumnSpacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:EmojiItem">
                                <controls:EmojiTile Item="{x:Bind}" Invoked="OnEmojiChosen"
                                                    IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                    Opacity="{x:Bind TileOpacity, Mode=OneWay}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollView>
            </Grid>
            <StackPanel
                x:Name="KitchenResultContent"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,16,0,0"
                Spacing="14"
                Visibility="Collapsed">
                <Grid x:Name="KitchenImageFrame" Width="128" Height="128" HorizontalAlignment="Center">
                    <Image x:Name="KitchenResultImage" Stretch="Uniform" />
                    <ProgressRing x:Name="KitchenResultLoadingRing" IsActive="False" Width="32" Height="32" />
                </Grid>
                <TextBlock x:Name="ResultMessage" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="280" Opacity="0.6" />
                <ComboBox
                    x:Name="KitchenSizeComboBox"
                    Header="Copied PNG size"
                    HorizontalAlignment="Center"
                    SelectionChanged="OnKitchenSizeChanged"
                    SelectedIndex="0">
                    <ComboBoxItem Content="48 x 48 (discord native size)" Tag="48" />
                    <ComboBoxItem Content="128 x 128" Tag="128" />
                    <ComboBoxItem Content="256 x 256" Tag="256" />
                    <ComboBoxItem Content="512 x 512" Tag="512" />
                </ComboBox>
                <Button
                    x:Name="KitchenCopyButton"
                    Content="Copy to clipboard"
                    HorizontalAlignment="Center"
                    Click="OnKitchenCopyClick"
                    IsEnabled="False" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
