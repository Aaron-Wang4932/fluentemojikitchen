<Window
    x:Class="FluentEmojiKitchen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:FluentEmojiKitchen.Views"
    xmlns:controls="using:FluentEmojiKitchen.Views.Controls"
    Title="FluentEmojiKitchen">
    <Grid Padding="0" CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:TabBar x:Name="Tabs" Grid.Row="0" />
        <Grid Grid.Row="1">
            <views:EmojiPanelView x:Name="EmojiPanel" />
            <views:KitchenPanelView x:Name="KitchenPanel" Visibility="Collapsed" />
            <controls:LoadingOverlay x:Name="StartupOverlay" />
        </Grid>
    </Grid>
</Window>
