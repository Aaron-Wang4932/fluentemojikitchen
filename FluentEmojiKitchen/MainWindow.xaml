<Window
    x:Class="FluentEmojiKitchen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentEmojiKitchen"
    xmlns:models="using:FluentEmojiKitchen.Models"
    >

    <Grid Padding="0" CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <Grid Grid.Row="0" Padding="12,10,12,6" x:Name="TabStripGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="6">
                <ToggleButton x:Name="EmojiTabButton" Content="Emoji" IsChecked="True"
                      Click="OnEmojiTabClick" CornerRadius="14" Padding="14,6" />
                <ToggleButton x:Name="KitchenTabButton" Content="Kitchen"
                      Click="OnKitchenTabClick" CornerRadius="14" Padding="14,6" />
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Column="1" Content="✕"
            Click="OnCloseButtonClick"
            Background="Transparent" BorderThickness="0"
            Padding="8,4" VerticalAlignment="Center" />
        </Grid>

        <!-- Search box -->
        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="12,0,12,8"
                 PlaceholderText="Search emojis" CornerRadius="6"
                 TextChanged="OnSearchTextChanged"
                 SelectionHighlightColor="DeepSkyBlue"/>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- Emoji tab: dynamically bound to EmojiDataService.Emojis -->
            <ScrollViewer x:Name="EmojiTabContent"
      Padding="8,0,8,12"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled">
                <ItemsRepeater x:Name="EmojiRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="48"
                        MinItemHeight="48"
                        ItemsStretch="Fill"
                        MinRowSpacing="2"
                        MinColumnSpacing="2" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:EmojiItemViewModel">
                            <Grid Width="48" Height="48"
                          Background="Transparent"
                          Tag="{x:Bind}"
                          PointerEntered="OnEmojiPointerEntered"
                          PointerExited="OnEmojiPointerExited"
                          Tapped="OnEmojiItemClick"
                          ToolTipService.ToolTip="{x:Bind EmojiName}">

                                <Border x:Name="HoverLayer"
                                CornerRadius="8"
                                Background="#55000000"
                                Opacity="0" />

                                <Border x:Name="SelectedLayer"
                                CornerRadius="8"
                                BorderThickness="2"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="{x:Bind SelectedOpacity, Mode=OneWay}" />

                                <TextBlock Text="{x:Bind Character}"
                                   FontFamily="{StaticResource NotoColorEmoji}"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <!-- Loading overlay: opaque, drawn on top of the grid above (z-order, not
         opacity) so the grid underneath is still genuinely painting/warming up
         while this covers it. -->
            <Grid x:Name="LoadingOverlay" Background="#2A2A2A">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Pre-caching emojis..." Opacity="0.6" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="LoadingProgressBar" Width="200" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </Grid>

            <!-- Kitchen tab: placeholder, not functional yet -->
            <Grid x:Name="KitchenTabContent" Visibility="Collapsed">
                <TextBlock Text="Emoji Kitchen — coming soon"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.6" />
            </Grid>
        </Grid>
    </Grid>
</Window>