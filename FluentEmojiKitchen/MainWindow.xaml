<Window
    x:Class="FluentEmojiKitchen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="0" CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <Grid Grid.Row="0" Padding="12,10,12,6" x:Name="TabStripGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="6">
                <ToggleButton x:Name="EmojiTabButton" Content="Emoji" IsChecked="True"
                      Click="OnEmojiTabClick" CornerRadius="14" Padding="14,6" />
                <ToggleButton x:Name="KitchenTabButton" Content="Kitchen"
                      Click="OnKitchenTabClick" CornerRadius="14" Padding="14,6" />
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Column="1" Content="✕"
            Click="OnCloseButtonClick"
            Background="Transparent" BorderThickness="0"
            Padding="8,4" VerticalAlignment="Center" />
        </Grid>

        <!-- Search box -->
        <TextBox x:Name="SearchBox" Grid.Row="1" Margin="12,0,12,8"
                 PlaceholderText="Search emojis" CornerRadius="6" />

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- Emoji tab: mirrors the native panel's "Recent" grid layout -->
            <ScrollViewer x:Name="EmojiTabContent" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="12,0,12,12" Spacing="8">
                    <TextBlock Text="Recent" FontSize="14" FontWeight="SemiBold" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🍑" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="💦" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="🍆" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="🥲" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="🐐" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="🔥" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🤣" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="🥺" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="😔" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="🥹" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="😂" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="5" Text="&#x1FAEA;" FontFamily="{StaticResource NotoColorEmoji}" FontSize="28" HorizontalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Kitchen tab: placeholder, not functional yet -->
            <Grid x:Name="KitchenTabContent" Visibility="Collapsed">
                <TextBlock Text="Emoji Kitchen — coming soon"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.6" />
            </Grid>
        </Grid>
    </Grid>
</Window>