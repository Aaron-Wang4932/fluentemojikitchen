<Window
    x:Class="FluentEmojiKitchen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FluentEmojiKitchen"
    xmlns:models="using:FluentEmojiKitchen.Models"
    xmlns:helpers="using:FluentEmojiKitchen.Helpers"
    >

    <Grid Padding="0" CornerRadius="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tab strip -->
        <Grid Grid.Row="0" Padding="12,10,12,6" x:Name="TabStripGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Spacing="6">
                <ToggleButton x:Name="EmojiTabButton" Content="Emoji" IsChecked="True"
                      Click="OnEmojiTabClick" CornerRadius="14" Padding="14,6" />
                <ToggleButton x:Name="KitchenTabButton" Content="Kitchen"
                      Click="OnKitchenTabClick" CornerRadius="14" Padding="14,6" />
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Column="1" Content="✕"
            Click="OnCloseButtonClick"
            Background="Transparent" BorderThickness="0"
            Padding="8,4" VerticalAlignment="Center" />
        </Grid>

        <!-- Search box -->
        <TextBox x:Name="EmojiPanelSearchBox" Grid.Row="1" Margin="12,0,12,8"
                 PlaceholderText="Search emojis" CornerRadius="6"
                 TextChanged="OnSearchTextChanged"
                 SelectionHighlightColor="DeepSkyBlue"
                 Visibility="Collapsed"/>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- Grouped view: shown when EmojiPanelSearchBox is empty -->
            <ScrollView x:Name="EmojiTabContent"
                  Padding="8,0,8,12"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Hidden"

                  ViewChanged="OnEmojiTabContentScrolled">
                <StackPanel>
                    <ItemsRepeater x:Name="EmojiRepeater" VerticalCacheLength="6">
                        <ItemsRepeater.Layout>
                            <helpers:EmojiSectionStackLayout />
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:EmojiSectionViewModel">
                                <StackPanel Spacing="2" Margin="0,0,0,8">
                                    <TextBlock Text="{x:Bind GroupName}"
                           Visibility="{x:Bind GroupHeadingVisibility}"
                           FontSize="16" FontWeight="SemiBold"
                           Margin="0,8,0,2" />
                                    <TextBlock Text="{x:Bind SubgroupName, Mode=OneWay}"
                           FontSize="12" Opacity="0.6"
                           Margin="0,0,0,4" />

                                    <ItemsRepeater ItemsSource="{x:Bind Emojis}" VerticalCacheLength="6">
                                        <ItemsRepeater.Layout>
                                            <UniformGridLayout MinItemWidth="48"
                        MinItemHeight="48"
                        ItemsStretch="Fill"
                        MinRowSpacing="2"
                        MinColumnSpacing="2" />
                                        </ItemsRepeater.Layout>

                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:EmojiItemViewModel">
                                                <Grid Width="48" Height="48"
                          Background="Transparent"
                          Tag="{x:Bind}"
                          PointerEntered="OnEmojiPointerEntered"
                          PointerExited="OnEmojiPointerExited"
                          Tapped="OnEmojiItemClick"
                          ToolTipService.ToolTip="{x:Bind EmojiName}">

                                                    <Border x:Name="HoverLayer"
                                CornerRadius="8"
                                Background="#55000000"
                                Opacity="0" />

                                                    <Border x:Name="SelectedLayer"
                                CornerRadius="8"
                                BorderThickness="2"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="{x:Bind SelectedOpacity, Mode=OneWay}" />

                                                    <TextBlock Text="{x:Bind Character}"
                                   FontFamily="{StaticResource NotoColorEmoji}"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="no more emojis down here o(〃＾▽＾〃)o"
                   HorizontalAlignment="Center"
                   Opacity="0.5"
                   Margin="0,16,0,24" />
                </StackPanel>



            </ScrollView>

            <!-- Flat search-results view: shown while EmojiPanelSearchBox has text -->
            <ScrollView x:Name="SearchResultsContent"
                  Padding="8,0,8,12"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Hidden"
                  Visibility="Collapsed">
                <ItemsRepeater x:Name="SearchResultsRepeater">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="48"
                        MinItemHeight="48"
                        ItemsStretch="Fill"
                        MinRowSpacing="2"
                        MinColumnSpacing="2" />
                    </ItemsRepeater.Layout>

                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:EmojiItemViewModel">
                            <Grid Width="48" Height="48"
                          Background="Transparent"
                          Tag="{x:Bind}"
                          PointerEntered="OnEmojiPointerEntered"
                          PointerExited="OnEmojiPointerExited"
                          Tapped="OnEmojiItemClick"
                          ToolTipService.ToolTip="{x:Bind EmojiName}">

                                <Border x:Name="HoverLayer"
                                CornerRadius="8"
                                Background="#55000000"
                                Opacity="0" />

                                <Border x:Name="SelectedLayer"
                                CornerRadius="8"
                                BorderThickness="2"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="{x:Bind SelectedOpacity, Mode=OneWay}" />

                                <TextBlock Text="{x:Bind Character}"
                                   FontFamily="{StaticResource NotoColorEmoji}"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollView>

            <!-- Loading overlay opaque and drawn on top of the grid above -->
            <Grid x:Name="LoadingOverlay" Background="#2A2A2A">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="Pre-caching emojis..." Opacity="0.6" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="LoadingProgressBar" Width="200" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </Grid>

            <!-- Kitchen tab -->
            <Grid x:Name="KitchenTabContent" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Two boxed-plus slots -->
                <StackPanel Grid.Row="0" Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,16" Spacing="20">

                    <Grid x:Name="KitchenSlotLeft" Width="72" Height="72" Tag="Left"
                          Background="Transparent" Tapped="OnKitchenSlotTapped">
                        <Rectangle x:Name="KitchenSlotLeftBorder"
                                   RadiusX="14" RadiusY="14"
                                   Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                   StrokeThickness="1.5" StrokeDashArray="4,3" />
                        <TextBlock x:Name="KitchenSlotLeftPlus" Text="+"
                                   FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.6" />
                        <TextBlock x:Name="KitchenSlotLeftEmoji"
                                   FontFamily="{StaticResource NotoColorEmoji}"
                                   FontSize="34"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <!-- Clear button: only visible once this slot has an emoji. Handles Tapped
                             (not Click) so it can mark the event Handled and stop it from bubbling up
                             to the slot Grid's own Tapped (which would otherwise re-open the picker). -->
                        <Button x:Name="KitchenSlotLeftClearButton" Tag="Left"
                                Content="✕" Tapped="OnKitchenSlotClearTapped"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-8,-8,0"
                                Width="22" Height="22" Padding="0" FontSize="10"
                                CornerRadius="11"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                    </Grid>

                    <Grid x:Name="KitchenSlotRight" Width="72" Height="72" Tag="Right"
                          Background="Transparent" Tapped="OnKitchenSlotTapped">
                        <Rectangle x:Name="KitchenSlotRightBorder"
                                   RadiusX="14" RadiusY="14"
                                   Stroke="{ThemeResource TextFillColorSecondaryBrush}"
                                   StrokeThickness="1.5" StrokeDashArray="4,3" />
                        <TextBlock x:Name="KitchenSlotRightPlus" Text="+"
                                   FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Opacity="0.6" />
                        <TextBlock x:Name="KitchenSlotRightEmoji"
                                   FontFamily="{StaticResource NotoColorEmoji}"
                                   FontSize="34"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <Button x:Name="KitchenSlotRightClearButton" Tag="Right"
                                Content="✕" Tapped="OnKitchenSlotClearTapped"
                                Visibility="Collapsed"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-8,-8,0"
                                Width="22" Height="22" Padding="0" FontSize="10"
                                CornerRadius="11"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                    </Grid>
                </StackPanel>

                <!-- Bottom area: swaps between placeholder hint / emoji picker (search + grouped/flat) / merged result -->
                <Grid Grid.Row="1">

                    <TextBlock x:Name="KitchenHintText"
                               Text="Pick two emoji to kitchenify them!"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                               Margin="0,24,0,0" Opacity="0.5" />

                    <!-- Emoji picker: shown while a slot is active -->
                    <Grid x:Name="KitchenPickerContent" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBox x:Name="KitchenSearchBox" Grid.Row="0"
                                 Margin="8,0,8,8"
                                 PlaceholderText="Search emojis"
                                 CornerRadius="6"
                                 TextChanged="OnKitchenSearchTextChanged" />

                        <!-- Grouped view (by Group only, no subgroup headings): shown when KitchenSearchBox is empty -->
                        <ScrollView x:Name="KitchenPickerGroupedContent" Grid.Row="1"
                                    Padding="8,0,8,12"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Hidden">
                            <ItemsRepeater x:Name="KitchenPickerRepeater" VerticalCacheLength="6">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="4" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:EmojiSectionViewModel">
                                        <StackPanel Spacing="2" Margin="0,0,0,8">
                                            <TextBlock Text="{x:Bind GroupName}"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Margin="0,8,0,2" />

                                            <ItemsRepeater ItemsSource="{x:Bind Emojis}" VerticalCacheLength="6">
                                                <ItemsRepeater.Layout>
                                                    <UniformGridLayout MinItemWidth="48" MinItemHeight="48"
                                                                       ItemsStretch="Fill"
                                                                       MinRowSpacing="2" MinColumnSpacing="2" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="models:EmojiItemViewModel">
                                                        <Grid Width="48" Height="48" Background="Transparent"
                                                              Tag="{x:Bind}"
                                                              PointerEntered="OnEmojiPointerEntered"
                                                              PointerExited="OnEmojiPointerExited"
                                                              Tapped="OnKitchenPickerEmojiClick"
                                                              ToolTipService.ToolTip="{x:Bind EmojiName}">
                                                            <Border x:Name="HoverLayer" CornerRadius="8" Background="#55000000" Opacity="0" />
                                                            <TextBlock Text="{x:Bind Character}"
                                                                       FontFamily="{StaticResource NotoColorEmoji}"
                                                                       FontSize="28"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       IsHitTestVisible="False" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollView>

                        <!-- Flat search-results view: shown while KitchenSearchBox has text -->
                        <ScrollView x:Name="KitchenPickerSearchResultsContent" Grid.Row="1"
                                    Padding="8,0,8,12"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Hidden"
                                    Visibility="Collapsed">
                            <ItemsRepeater x:Name="KitchenPickerSearchResultsRepeater">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="48" MinItemHeight="48"
                                                       ItemsStretch="Fill"
                                                       MinRowSpacing="2" MinColumnSpacing="2" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:EmojiItemViewModel">
                                        <Grid Width="48" Height="48" Background="Transparent"
                                              Tag="{x:Bind}"
                                              PointerEntered="OnEmojiPointerEntered"
                                              PointerExited="OnEmojiPointerExited"
                                              Tapped="OnKitchenPickerEmojiClick"
                                              ToolTipService.ToolTip="{x:Bind EmojiName}">
                                            <Border x:Name="HoverLayer" CornerRadius="8" Background="#55000000" Opacity="0" />
                                            <TextBlock Text="{x:Bind Character}"
                                                       FontFamily="{StaticResource NotoColorEmoji}"
                                                       FontSize="28"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollView>
                    </Grid>

                    <!-- Merged result: shown once both slots are filled -->
                    <StackPanel x:Name="KitchenResultContent"
                                HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,16,0,0" Spacing="14"
                                Visibility="Collapsed">

                        <Grid Width="128" Height="128" HorizontalAlignment="Center">
                            <Image x:Name="KitchenResultImage" Stretch="Uniform" />
                            <ProgressRing x:Name="KitchenResultLoadingRing"
                                          IsActive="False" Width="32" Height="32" />
                        </Grid>

                        <ComboBox x:Name="KitchenSizeComboBox"
                                  Header="PNG size" HorizontalAlignment="Center"
                                  SelectionChanged="OnKitchenSizeChanged"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="48 x 48 (discord native size)" Tag="48" />
                            <ComboBoxItem Content="128 x 128" Tag="128" />
                            <ComboBoxItem Content="256 x 256" Tag="256" />
                            <ComboBoxItem Content="512 x 512" Tag="512" />
                        </ComboBox>

                        <Button x:Name="KitchenCopyButton" Content="Copy to clipboard"
                                HorizontalAlignment="Center"
                                Click="OnKitchenCopyClick" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Button x:Name="ScrollToTopButton"
                Visibility="Collapsed"
                Click="OnScrollToTopClick"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                CornerRadius="20"
                Width="40" Height="40"
                Padding="0"
                Opacity="0"
                IsHitTestVisible="False"
                Background="#CC2A2A2A">
                <FontIcon Glyph="&#xE70E;" FontSize="16" />
                <!-- chevron-up glyph -->
            </Button>

        </Grid>
    </Grid>
</Window>
